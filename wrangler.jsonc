{
  "name": "elisacane",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Ogni richiesta passa dal Worker: aggiunge gli header di sicurezza e i reindirizzamenti
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "CONTENT", "id": "06b5143b0c0d4d9b8dbbf5992ceba9a4" }
  ],
  "routes": [
    { "pattern": "elisacanepsicologa.it", "custom_domain": true },
    { "pattern": "www.elisacanepsicologa.it", "custom_domain": true }
  ],
  // Non cancellare le variabili impostate dal pannello Cloudflare a ogni deploy
  "keep_vars": true,
  // Il sito risponde solo sui domini indicati sopra (niente indirizzi *.workers.dev)
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
